{
  "name": "picocare-meta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.12.0" },
  "scripts": {
    "build": "tsc -p tsconfig.web.json",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test tests/*.test.ts",
    "start": "node src/server.ts",
    "start:meta": "node --env-file-if-exists=.env.local src/server.ts",
    "meta:check": "node --env-file-if-exists=.env.local scripts/check-meta.ts",
    "dev": "node --watch src/server.ts",
    "demo:secretary": "node scripts/demo-secretary.ts"
  },
  "devDependencies": { "@types/node": "24.10.1", "typescript": "5.9.3" }
}
