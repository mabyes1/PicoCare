# Copy to .env.local. Keep the real key only in .env.local.
MODEL_API_KEY=
PICOCARE_META_ENABLED=true
PICOCARE_META_MODEL=muse-spark-1.3
PICOCARE_META_INTERVAL_SECONDS=120
PICOCARE_META_DAILY_LIMIT=60
PICOCARE_META_MAX_TOKENS=1536
PICOCARE_META_NOTIFICATION_TEXT=false
# Optional: weekly review via Meta open weights on Baseten (Best Open Weight path).
BASENTEN_API_KEY=
BASENTEN_MODEL=meta-models/muse-spark-open-1026
